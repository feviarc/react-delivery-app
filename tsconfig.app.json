{
  "compilerOptions": {
    "composite": true, // Necesario para referencias
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": false, // Debe ser false para permitir emisión de tipos
    "outDir": "./dist", // Añadir esta línea
    "rootDir": "./src" // Añadir esta línea
  },
  "include": ["src"]
}
